{
	"name": "cinephage",
	"private": true,
	"version": "0.0.0-development",
	"license": "GPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:host": "vite dev --host",
		"build": "NODE_OPTIONS=--max-old-space-size=8192 VITE_SSR_BUILD=1 vite build",
		"start": "node server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "NODE_OPTIONS=--max-old-space-size=8192 svelte-kit sync && NODE_OPTIONS=--max-old-space-size=8192 svelte-check --tsconfig ./tsconfig.json --config vite.config.ts",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --config vite.config.ts --watch",
		"format": "prettier --write .",
		"lint": "NODE_OPTIONS=--max-old-space-size=8192 prettier --check . && NODE_OPTIONS=--max-old-space-size=8192 eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:coverage": "vitest run --coverage",
		"test:live": "LIVE_TESTS=true vitest run src/lib/server/subtitles/providers.live.test.ts src/lib/server/tmdb.live.test.ts src/lib/server/streaming/utils/cloudflare-streaming.live.test.ts src/lib/server/subtitles/providers/supersubtitles/SuperSubtitlesProvider.live.test.ts",
		"deps:audit": "npx --yes knip --dependencies --include dependencies,devDependencies --no-progress --reporter compact",
		"camoufox:update": "camoufox fetch",
		"migrate:remove-enabled": "tsx scripts/remove-monitoring-enabled.ts",
		"auth:reset-admin-password": "node scripts/reset-admin-password.js",
		"fix:tv-subtitles": "node scripts/fix-tv-subtitle-paths.js",
		"fix:episode-file-links": "node scripts/repair-episode-file-links.js",
		"library:backfill-release-metadata": "npx tsx scripts/backfill-release-metadata.ts",
		"library:export-release-metadata-audit": "npx tsx scripts/export-release-metadata-audit.ts",
		"generate:language-data": "npx tsx scripts/generate-language-data.ts",
		"db:reset": "rm -f data/cinephage.db && echo 'Database deleted. Will be recreated on next startup.'",
		"db:info": "sqlite3 data/cinephage.db \"SELECT value FROM settings WHERE key='schema_version'\" 2>/dev/null || echo 'No database found'"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.26.0",
		"@lucide/svelte": "^1.53.0",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/github": "^12.0.10",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/adm-zip": "^0.5.8",
		"@types/better-sqlite3": "^9.0.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^26.1.2",
		"@types/parse-torrent": "^11.0.0",
		"@vitest/coverage-v8": "^5.0.3",
		"daisyui": "^5.7.47",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"iso-639-3": "^3.0.1",
		"jsdom": "^30.1.2",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"npm": "file:tools/npm-stub",
		"semantic-release": "^25.0.9",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"devalue": "^5.7.1",
		"postcss": "^8.5.25",
		"undici": "^8.0.0",
		"npm": "$npm",
		"tar": "7.5.22",
		"brace-expansion": "5.0.12"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-arm64-gnu": "^4.62.3",
		"@rollup/rollup-linux-x64-gnu": "^4.62.3"
	},
	"dependencies": {
		"@better-auth/api-key": "1.7.7",
		"@parcel/watcher": "^2.6.0",
		"adm-zip": "^0.6.1",
		"better-auth": "1.7.7",
		"better-sqlite3": "^13.0.3",
		"camoufox": "^0.5.8",
		"cheerio": "^1.2.0",
		"date-format-parse": "^0.2.7",
		"domhandler": "^6.0.1",
		"dotenv": "^18.0.6",
		"drizzle-orm": "^0.45.3",
		"fast-xml-parser": "^5.11.2",
		"fflate": "^0.8.3",
		"guessit-js": "^4.8.0",
		"iconv-lite": "^0.7.3",
		"js-yaml": "^5.4.3",
		"minimatch": "^10.2.6",
		"parse-torrent": "^11.0.24",
		"pino": "^10.4.0",
		"playwright-core": "~1.62.0",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
